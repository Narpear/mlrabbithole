---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        }
      } catch {
        // Storage can be unavailable in private or restricted browsing contexts.
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label="ML Rabbit Hole home">
          <span>ML </span><span class="wordmark__accent">Rabbit</span><span> Hole</span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/">Posts</a>
          <a href="/about/">About</a>
          <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Toggle theme">
            <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            </svg>
            <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.2 15.6A8.5 8.5 0 0 1 8.4 3.8 8.5 8.5 0 1 0 20.2 15.6Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <a href="/">{SITE.title}</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');

      function currentTheme() {
        return document.documentElement.dataset.theme
          ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      }

      function updateToggle(theme: string) {
        toggle?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
      }

      updateToggle(currentTheme());
      toggle?.addEventListener('click', () => {
        const theme = currentTheme() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {
          // Keep the in-page toggle usable when storage is unavailable.
        }
        updateToggle(theme);
        window.dispatchEvent(new CustomEvent('site-theme-change', { detail: { theme } }));
      });
    </script>
  </body>
</html>