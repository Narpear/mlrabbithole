---
const id = `kl-${crypto.randomUUID()}`;
---

<figure class="kl-demo" data-kl-demo>
  <div class="kl-demo__plot-wrap">
    <canvas data-plot width="360" height="300" aria-label="Four digit latent clouds moving and changing size as the KL weight changes"></canvas>
    <span class="kl-demo__axis kl-demo__axis--x">z₁</span>
    <span class="kl-demo__axis kl-demo__axis--y">z₂</span>
  </div>
  <label class="kl-demo__control" for={id}>
    <span><span>KL weight β</span><output data-beta for={id}>0.25</output></span>
    <input id={id} data-slider type="range" min="0" max="1" step="0.01" value="0.25" />
    <span class="kl-demo__ends"><span>reconstruction wins</span><span>prior wins</span></span>
  </label>
  <p class="kl-demo__readout" data-readout aria-live="polite"></p>
  <figcaption>Too little KL leaves holes; too much KL blurs digits together. The useful tradeoff sits between. Toy simulation, not a trained model.</figcaption>
</figure>

<script>
  const cloudSpecs = [
    { label: '0', x: -1.55, y: 0.85 },
    { label: '1', x: 1.45, y: 1.1 },
    { label: '7', x: 1.45, y: -1.15 },
    { label: '4', x: -1.5, y: -1.0 },
  ];

  document.querySelectorAll<HTMLElement>('[data-kl-demo]').forEach((demo) => {
    const plot = demo.querySelector<HTMLCanvasElement>('[data-plot]');
    const slider = demo.querySelector<HTMLInputElement>('[data-slider]');
    const betaOutput = demo.querySelector<HTMLOutputElement>('[data-beta]');
    const readout = demo.querySelector<HTMLElement>('[data-readout]');
    if (!plot || !slider || !betaOutput || !readout) return;
    const context = plot.getContext('2d');
    if (!context) return;
    const color = (name: string, fallback: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
    const map = (x: number, y: number) => [30 + (x + 3) * 50, 20 + (3 - y) * 43];

    const draw = () => {
      const beta = Number(slider.value);
      const ink = color('--ink', '#202a26');
      const muted = color('--muted', '#69756f');
      const line = color('--line', '#dfe5df');
      const accent = color('--accent', '#0f6e56');
      const surface = color('--surface', '#ffffff');
      const standardDeviation = 0.16 + beta * 0.84;
      const centers = cloudSpecs.map((cloud) => ({ x: cloud.x * (1 - beta), y: cloud.y * (1 - beta) }));
      context.clearRect(0, 0, plot.width, plot.height);
      context.fillStyle = surface;
      context.fillRect(0, 0, plot.width, plot.height);
      context.strokeStyle = line;
      context.lineWidth = 1;
      for (let tick = -3; tick <= 3; tick++) {
        const [x] = map(tick, 0);
        const [, y] = map(0, tick);
        context.beginPath(); context.moveTo(x, 20); context.lineTo(x, 278); context.stroke();
        context.beginPath(); context.moveTo(30, y); context.lineTo(330, y); context.stroke();
      }
      const [originX, originY] = map(0, 0);
      context.beginPath();
      context.arc(originX, originY, 50, 0, Math.PI * 2);
      context.setLineDash([5, 4]);
      context.strokeStyle = muted;
      context.lineWidth = 1.5;
      context.stroke();
      context.setLineDash([]);
      context.fillStyle = muted;
      context.font = '10px monospace';
      context.fillText('N(0, I)', originX + 53, originY - 4);

      centers.forEach((center, index) => {
        const [x, y] = map(center.x, center.y);
        context.beginPath();
        context.ellipse(x, y, standardDeviation * 50, standardDeviation * 43, 0, 0, Math.PI * 2);
        context.globalAlpha = 0.14;
        context.fillStyle = accent;
        context.fill();
        context.globalAlpha = 0.75;
        context.strokeStyle = accent;
        context.lineWidth = 1.4;
        context.stroke();
        context.globalAlpha = 1;
        context.beginPath(); context.arc(x, y, 3, 0, Math.PI * 2); context.fillStyle = ink; context.fill();
        context.fillStyle = ink; context.font = '11px monospace'; context.fillText(cloudSpecs[index].label, x + 7, y - 6);
      });

      let covered = 0;
      const gridSize = 31;
      for (let row = 0; row < gridSize; row++) {
        for (let column = 0; column < gridSize; column++) {
          const x = -3 + column * 6 / (gridSize - 1);
          const y = -3 + row * 6 / (gridSize - 1);
          if (centers.some((center) => ((x - center.x) ** 2 + (y - center.y) ** 2) / standardDeviation ** 2 <= 4)) covered++;
        }
      }
      let overlaps = 0;
      for (let first = 0; first < centers.length; first++) {
        for (let second = first + 1; second < centers.length; second++) {
          const distance = Math.hypot(centers[first].x - centers[second].x, centers[first].y - centers[second].y);
          if (distance <= standardDeviation * 2) overlaps++;
        }
      }
      betaOutput.value = beta.toFixed(2);
      readout.textContent = `coverage: ${Math.round(covered / (gridSize * gridSize) * 100)}% · overlapping pairs: ${overlaps}/6`;
    };
    slider.addEventListener('input', draw);
    new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    draw();
  });
</script>

<style>
  .kl-demo { margin: 2rem 0; padding: 1.2rem; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .kl-demo__plot-wrap { position: relative; min-width: 0; }
  .kl-demo canvas { display: block; width: 100%; height: auto; aspect-ratio: 6 / 5; border: 1px solid var(--line); border-radius: 3px; }
  .kl-demo__axis { position: absolute; color: var(--muted); font: 0.68rem var(--font-mono); pointer-events: none; }
  .kl-demo__axis--x { right: 0.45rem; bottom: 0.2rem; }
  .kl-demo__axis--y { top: 0.25rem; left: 0.35rem; }
  .kl-demo__control { display: grid; gap: 0.55rem; margin-top: 1rem; color: var(--ink); font: 0.8rem var(--font-ui); }
  .kl-demo__control > span:first-child { display: flex; justify-content: space-between; }
  .kl-demo output, .kl-demo__readout { color: var(--muted); font: 0.74rem var(--font-mono); font-variant-numeric: tabular-nums; }
  .kl-demo input[type='range'] { width: 100%; accent-color: var(--accent); }
  .kl-demo__ends { display: flex; justify-content: space-between; gap: 0.6rem; color: var(--muted); font: 0.7rem var(--font-ui); }
  .kl-demo__readout, .kl-demo figcaption { margin: 0.7rem 0 0; line-height: 1.6; }
  .kl-demo__readout { color: var(--muted); font: 0.74rem/1.6 var(--font-mono); }
  .kl-demo figcaption { color: var(--muted); font: 0.78rem/1.6 var(--font-ui); }
  @media (max-width: 480px) { .kl-demo { padding: 0.8rem; } .kl-demo__ends { font-size: 0.62rem; } }
</style>